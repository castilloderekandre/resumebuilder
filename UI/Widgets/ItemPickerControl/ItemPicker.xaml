<UserControl x:Class="UI.Widgets.ItemPickerControl.ItemPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UI.Widgets.ItemPickerControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid x:Name="ParentGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="1" Content="Left" HorizontalAlignment="Center" Margin="0,190,0,0" VerticalAlignment="Top"/>
        <Button Grid.Column="1" Content="Right" HorizontalAlignment="Center" Margin="0,237,0,0" VerticalAlignment="Top"/>
    </Grid>
</UserControl>
